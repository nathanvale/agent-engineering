{
  "admissionVersion": 1,
  "cli": "specimen",
  "cases": [
    {
      "caseId": "provider-loading.valid/help",
      "rules": [
        "provider-loading",
        "json-framing",
        "version-malformed",
        "strict-keys",
        "result-correlation",
        "machine-stderr",
        "exit-envelope",
        "exit-expected",
        "cause-expected"
      ],
      "role": "help",
      "mode": "machine",
      "target": {
        "kind": "run",
        "program": "bun-runtime",
        "args": ["../../../specimens/target.mjs", "--help", "--json"],
        "cwd": ".",
        "env": {
          "SPECIMEN_TABLE": "help.table.json",
          "SPECIMEN_PROVIDER": "unavailable"
        }
      },
      "expect": {
        "exitCode": 0,
        "causeCode": "SUCCESS_UNCHANGED",
        "outcome": "success",
        "commandIdentity": "specimen.help"
      },
      "probe": {
        "program": "bun-runtime",
        "args": ["../../../specimens/probe.mjs"],
        "cwd": ".",
        "env": {
          "SPECIMEN_STATE": "state.log"
        },
        "expectedStdout": ""
      }
    },
