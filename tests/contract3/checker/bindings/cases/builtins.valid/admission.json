{
  "admissionVersion": 1,
  "cli": "specimen",
  "cases": [
    {
      "caseId": "builtins.valid/discovery",
      "rules": [
        "json-framing",
        "version-malformed",
        "strict-keys",
        "result-correlation",
        "machine-stderr",
        "exit-envelope",
        "exit-expected",
        "cause-expected",
        "builtins"
      ],
      "role": "discovery",
      "mode": "machine",
      "target": {
        "kind": "run",
        "program": "bun-runtime",
        "args": ["../../../specimens/target.mjs", "--discover", "--json"],
        "cwd": ".",
        "env": {
          "SPECIMEN_TABLE": "discovery.table.json"
        }
      },
      "expect": {
        "exitCode": 0,
        "causeCode": "SUCCESS_UNCHANGED",
        "outcome": "success",
        "commandIdentity": "specimen.discovery"
      }
    },
