{
  "admissionVersion": 1,
  "cli": "specimen",
  "cases": [
    {
      "caseId": "machine-stderr.valid.discovery/subject",
      "rules": [
        "machine-stderr",
        "json-framing",
        "version-malformed",
        "strict-keys",
        "result-correlation",
        "exit-envelope",
        "exit-expected",
        "cause-expected"
      ],
      "role": "discovery",
      "mode": "machine",
      "target": {
        "kind": "run",
        "program": "bun-runtime",
        "args": ["../../../specimens/target.mjs", "--discover", "--json"],
        "cwd": ".",
        "env": {
          "SPECIMEN_TABLE": "subject.table.json"
        }
      },
      "expect": {
        "exitCode": 0,
        "causeCode": "SUCCESS_UNCHANGED",
        "outcome": "success",
        "commandIdentity": "specimen.discovery"
      }
    }
  ]
}
