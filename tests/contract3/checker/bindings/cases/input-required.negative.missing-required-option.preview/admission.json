{
  "admissionVersion": 1,
  "cli": "specimen",
  "cases": [
    {
      "caseId": "input-required.negative.missing-required-option.preview/discovery",
      "rules": [
        "json-framing",
        "version-malformed",
        "strict-keys",
        "version-copy",
        "discovery-metadata",
        "root-routes"
      ],
      "role": "discovery",
      "mode": "machine",
      "target": {
        "kind": "captured",
        "stdout": "../../shared/discovery.stdout",
        "stderr": "../../shared/empty.stderr",
        "exit": {
          "code": 0
        }
      }
    },
    {
      "caseId": "input-required.negative.missing-required-option.preview/cd-preview",
      "rules": [
        "json-framing",
        "version-malformed",
        "strict-keys",
        "station-duplicate",
        "retry-policy",
        "input-schema"
      ],
      "role": "command-discovery",
      "mode": "machine",
      "target": {
        "kind": "captured",
        "stdout": "../../shared/cd-preview.stdout",
        "stderr": "../../shared/empty.stderr",
        "exit": {
          "code": 0
        }
      }
    },
    {
      "caseId": "input-required.negative.missing-required-option.preview/subject",
      "rules": [
        "input-required",
        "json-framing",
        "version-malformed",
        "strict-keys",
        "result-correlation",
        "machine-stderr",
        "exit-envelope",
        "station-observed"
      ],
      "role": "command",
      "mode": "machine",
      "target": {
        "kind": "run",
        "program": "bun-runtime",
        "args": ["../../../specimens/target.mjs", "preview", "--json"],
        "cwd": ".",
        "env": {
          "SPECIMEN_TABLE": "subject.table.json"
        }
      },
      "expect": {
        "exitCode": 2
      }
    }
  ]
}
