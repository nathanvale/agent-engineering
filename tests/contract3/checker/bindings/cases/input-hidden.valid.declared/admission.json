{
  "admissionVersion": 1,
  "cli": "specimen",
  "cases": [
    {
      "caseId": "input-hidden.valid.declared/discovery",
      "rules": [
        "json-framing",
        "version-malformed",
        "strict-keys",
        "version-copy",
        "discovery-metadata",
        "root-routes"
      ],
      "role": "discovery",
      "mode": "machine",
      "target": {
        "kind": "captured",
        "stdout": "../../shared/discovery.stdout",
        "stderr": "../../shared/empty.stderr",
        "exit": {
          "code": 0
        }
      }
    },
    {
      "caseId": "input-hidden.valid.declared/cd-show",
      "rules": [
        "json-framing",
        "version-malformed",
        "strict-keys",
        "station-duplicate",
        "retry-policy",
        "input-schema"
      ],
      "role": "command-discovery",
      "mode": "machine",
      "target": {
        "kind": "captured",
        "stdout": "../../shared/cd-show.stdout",
        "stderr": "../../shared/empty.stderr",
        "exit": {
          "code": 0
        }
      }
    },
    {
      "caseId": "input-hidden.valid.declared/subject",
      "rules": [
        "input-hidden",
        "json-framing",
        "version-malformed",
        "strict-keys",
        "result-correlation",
        "machine-stderr",
        "exit-envelope",
        "exit-expected",
        "cause-expected",
        "station-observed"
      ],
      "role": "command",
      "mode": "machine",
      "target": {
        "kind": "run",
        "program": "bun-runtime",
        "args": ["../../../specimens/target.mjs", "show", "--json", "n-1"],
        "cwd": ".",
        "env": {
          "SPECIMEN_TABLE": "subject.table.json"
        }
      },
      "expect": {
        "exitCode": 0,
        "causeCode": "SUCCESS_UNCHANGED",
        "outcome": "success",
        "commandIdentity": "specimen.show"
      }
    }
  ]
}
