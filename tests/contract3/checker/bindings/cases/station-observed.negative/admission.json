{
  "admissionVersion": 1,
  "cli": "specimen",
  "cases": [
    {
      "caseId": "station-observed.negative/discovery",
      "rules": [
        "json-framing",
        "version-malformed",
        "strict-keys",
        "version-copy",
        "discovery-metadata",
        "root-routes"
      ],
      "role": "discovery",
      "mode": "machine",
      "target": {
        "kind": "captured",
        "stdout": "../../shared/discovery.stdout",
        "stderr": "../../shared/empty.stderr",
        "exit": {
          "code": 0
        }
      }
    },
    {
      "caseId": "station-observed.negative/cd-show",
      "rules": [
        "json-framing",
        "version-malformed",
        "strict-keys",
        "station-duplicate",
        "retry-policy",
        "input-schema"
      ],
      "role": "command-discovery",
      "mode": "machine",
      "target": {
        "kind": "captured",
        "stdout": "../../shared/cd-show.stdout",
        "stderr": "../../shared/empty.stderr",
        "exit": {
          "code": 0
        }
      }
    },
    {
      "caseId": "station-observed.negative/subject",
      "rules": [
        "station-observed",
        "json-framing",
        "version-malformed",
        "strict-keys",
        "machine-stderr",
        "exit-envelope",
        "exit-expected"
      ],
      "role": "command",
      "mode": "machine",
      "target": {
        "kind": "run",
        "program": "bun-runtime",
        "args": ["../../../specimens/target.mjs", "show", "n-9", "--json"],
        "cwd": ".",
        "env": {
          "SPECIMEN_TABLE": "subject.table.json"
        }
      },
      "expect": {
        "exitCode": 3,
        "outcome": "refused"
      }
    }
  ]
}
