{
  "admissionVersion": 1,
  "cli": "specimen",
  "cases": [
    {
      "caseId": "no-replay.valid.pattern-budget/discovery",
      "rules": [
        "json-framing",
        "version-malformed",
        "strict-keys",
        "version-copy",
        "discovery-metadata",
        "root-routes"
      ],
      "role": "discovery",
      "mode": "machine",
      "target": {
        "kind": "captured",
        "stdout": "../../shared/discovery.stdout",
        "stderr": "../../shared/empty.stderr",
        "exit": {
          "code": 0
        }
      }
    },
    {
      "caseId": "no-replay.valid.pattern-budget/cd-find",
      "rules": [
        "json-framing",
        "version-malformed",
        "strict-keys",
        "result-correlation",
        "machine-stderr",
        "exit-envelope",
        "exit-expected",
        "cause-expected",
        "pattern-syntax"
      ],
      "role": "command-discovery",
      "mode": "machine",
      "target": {
        "kind": "run",
        "program": "bun-runtime",
        "args": [
          "../../../specimens/target.mjs",
          "--discover-command",
          "specimen.find",
          "--json"
        ],
        "cwd": ".",
        "env": {
          "SPECIMEN_TABLE": "cd-find.table.json",
          "SPECIMEN_COUNTER": "no-replay.counter"
        }
      },
      "expect": {
        "exitCode": 0,
        "causeCode": "SUCCESS_UNCHANGED",
        "outcome": "success",
        "commandIdentity": "specimen.command-discovery"
      }
    },
    {
      "caseId": "no-replay.valid.pattern-budget/subject",
      "rules": [
        "pattern-budget",
        "json-framing",
        "version-malformed",
        "strict-keys",
        "result-correlation",
        "machine-stderr",
        "exit-envelope",
        "exit-expected",
        "cause-expected"
      ],
      "role": "command",
      "mode": "machine",
      "target": {
        "kind": "run",
        "program": "bun-runtime",
        "args": [
          "../../../specimens/target.mjs",
          "find",
          "--json",
          "abc",
          "--code",
          "abc"
        ],
        "cwd": ".",
        "env": {
          "SPECIMEN_TABLE": "subject.table.json",
          "SPECIMEN_COUNTER": "no-replay.input.counter"
        }
      },
      "expect": {
        "exitCode": 0,
        "causeCode": "SUCCESS_UNCHANGED",
        "outcome": "success",
        "commandIdentity": "specimen.find"
      }
    }
  ]
}
