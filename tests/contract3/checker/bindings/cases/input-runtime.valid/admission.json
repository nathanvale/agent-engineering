{
  "admissionVersion": 1,
  "cli": "specimen",
  "cases": [
    {
      "caseId": "input-runtime.valid/discovery",
      "rules": [
        "json-framing",
        "version-malformed",
        "strict-keys",
        "version-copy",
        "discovery-metadata",
        "root-routes"
      ],
      "role": "discovery",
      "mode": "machine",
      "target": {
        "kind": "captured",
        "stdout": "../../shared/discovery.stdout",
        "stderr": "../../shared/empty.stderr",
        "exit": {
          "code": 0
        }
      }
    },
    {
      "caseId": "input-runtime.valid/cd-apply",
      "rules": [
        "json-framing",
        "version-malformed",
        "strict-keys",
        "station-duplicate",
        "retry-policy",
        "input-schema"
      ],
      "role": "command-discovery",
      "mode": "machine",
      "target": {
        "kind": "captured",
        "stdout": "../../shared/cd-apply.stdout",
        "stderr": "../../shared/empty.stderr",
        "exit": {
          "code": 0
        }
      }
    },
    {
      "caseId": "input-runtime.valid/subject",
      "rules": [
        "input-runtime",
        "json-framing",
        "version-malformed",
        "strict-keys",
        "result-correlation",
        "machine-stderr",
        "exit-envelope",
        "exit-expected",
        "cause-expected",
        "station-observed"
      ],
      "role": "command",
      "mode": "machine",
      "target": {
        "kind": "run",
        "program": "bun-runtime",
        "args": [
          "../../../specimens/target.mjs",
          "apply",
          "--preview",
          "pv-missing",
          "--json"
        ],
        "cwd": ".",
        "env": {
          "SPECIMEN_TABLE": "subject.table.json"
        }
      },
      "expect": {
        "exitCode": 3,
        "causeCode": "DOMAIN_PREVIEW_MISSING",
        "outcome": "refused",
        "commandIdentity": "specimen.apply"
      },
      "probe": {
        "program": "bun-runtime",
        "args": ["../../../specimens/probe.mjs"],
        "cwd": ".",
        "env": {
          "SPECIMEN_STATE": "state.log"
        },
        "expectedStdout": ""
      }
    }
  ]
}
