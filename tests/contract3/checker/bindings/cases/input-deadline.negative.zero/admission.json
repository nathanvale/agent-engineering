{
  "admissionVersion": 1,
  "cli": "specimen",
  "cases": [
    {
      "caseId": "input-deadline.negative.zero/discovery",
      "rules": [
        "json-framing",
        "version-malformed",
        "strict-keys",
        "version-copy",
        "discovery-metadata",
        "root-routes"
      ],
      "role": "discovery",
      "mode": "machine",
      "target": {
        "kind": "captured",
        "stdout": "../../shared/discovery.stdout",
        "stderr": "../../shared/empty.stderr",
        "exit": {
          "code": 0
        }
      }
    },
    {
      "caseId": "input-deadline.negative.zero/cd-apply",
      "rules": [
        "json-framing",
        "version-malformed",
        "strict-keys",
        "station-duplicate",
        "retry-policy",
        "input-schema"
      ],
      "role": "command-discovery",
      "mode": "machine",
      "target": {
        "kind": "captured",
        "stdout": "../../shared/cd-apply.stdout",
        "stderr": "../../shared/empty.stderr",
        "exit": {
          "code": 0
        }
      }
    },
    {
      "caseId": "input-deadline.negative.zero/cd-dispatch",
      "rules": [
        "json-framing",
        "version-malformed",
        "strict-keys",
        "station-duplicate",
        "retry-policy",
        "input-schema"
      ],
      "role": "command-discovery",
      "mode": "machine",
      "target": {
        "kind": "captured",
        "stdout": "../../shared/cd-dispatch.stdout",
        "stderr": "../../shared/empty.stderr",
        "exit": {
          "code": 0
        }
      }
    },
    {
      "caseId": "input-deadline.negative.zero/subject",
      "rules": [
        "input-deadline",
        "json-framing",
        "version-malformed",
        "strict-keys",
        "result-correlation",
        "machine-stderr",
        "exit-envelope",
        "station-observed"
      ],
      "role": "command",
      "mode": "machine",
      "target": {
        "kind": "run",
        "program": "bun-runtime",
        "args": [
          "../../../specimens/target.mjs",
          "apply",
          "--json",
          "--preview",
          "pv-7f3a",
          "--deadline-ms",
          "0"
        ],
        "cwd": ".",
        "env": {
          "SPECIMEN_TABLE": "subject.table.json"
        }
      },
      "expect": {
        "exitCode": 2,
        "commandIdentity": "specimen.dispatch"
      }
    }
  ]
}
