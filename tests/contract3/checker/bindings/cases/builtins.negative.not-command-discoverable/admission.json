{
  "admissionVersion": 1,
  "cli": "specimen",
  "cases": [
    {
      "caseId": "builtins.negative.not-command-discoverable/subject",
      "rules": [
        "builtins",
        "json-framing",
        "version-malformed",
        "strict-keys",
        "result-correlation",
        "machine-stderr",
        "exit-envelope"
      ],
      "role": "command-discovery",
      "mode": "machine",
      "target": {
        "kind": "run",
        "program": "bun-runtime",
        "args": [
          "../../../specimens/target.mjs",
          "--discover-command",
          "specimen.dispatch",
          "--json"
        ],
        "cwd": ".",
        "env": {
          "SPECIMEN_TABLE": "subject.table.json"
        }
      },
      "expect": {
        "exitCode": 0
      }
    }
  ]
}
