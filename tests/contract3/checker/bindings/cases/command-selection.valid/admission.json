{
  "admissionVersion": 1,
  "cli": "specimen",
  "cases": [
    {
      "caseId": "command-selection.valid/subject",
      "rules": [
        "command-selection",
        "json-framing",
        "version-malformed",
        "strict-keys",
        "result-correlation",
        "machine-stderr",
        "exit-envelope",
        "exit-expected",
        "cause-expected"
      ],
      "role": "command-discovery",
      "mode": "machine",
      "target": {
        "kind": "run",
        "program": "bun-runtime",
        "args": [
          "../../../specimens/target.mjs",
          "--discover-command",
          "specimen.list",
          "--json"
        ],
        "cwd": ".",
        "env": {
          "SPECIMEN_TABLE": "subject.table.json"
        }
      },
      "expect": {
        "exitCode": 0,
        "causeCode": "SUCCESS_UNCHANGED",
        "outcome": "success",
        "commandIdentity": "specimen.command-discovery"
      }
    }
  ]
}
