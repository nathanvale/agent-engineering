{
  "admissionVersion": 1,
  "cli": "specimen",
  "cases": [
    {
      "caseId": "station-required.valid/discovery",
      "rules": [
        "json-framing",
        "version-malformed",
        "strict-keys",
        "version-copy",
        "discovery-metadata",
        "root-routes"
      ],
      "role": "discovery",
      "mode": "machine",
      "target": {
        "kind": "captured",
        "stdout": "../../shared/discovery.stdout",
        "stderr": "../../shared/empty.stderr",
        "exit": {
          "code": 0
        }
      }
    },
    {
      "caseId": "station-required.valid/list-ok",
      "rules": [
        "json-framing",
        "version-malformed",
        "strict-keys",
        "result-correlation",
        "machine-stderr",
        "exit-envelope",
        "exit-expected",
        "cause-expected"
      ],
      "role": "command",
      "mode": "machine",
      "target": {
        "kind": "run",
        "program": "bun-runtime",
        "args": ["../../../specimens/target.mjs", "list", "--json"],
        "cwd": ".",
        "env": {
          "SPECIMEN_TABLE": "list-ok.table.json"
        }
      },
      "expect": {
        "exitCode": 0,
        "causeCode": "SUCCESS_UNCHANGED",
        "outcome": "success",
        "commandIdentity": "specimen.list"
      }
    },
    {
      "caseId": "station-required.valid/list-usage",
      "rules": [
        "json-framing",
        "version-malformed",
        "strict-keys",
        "result-correlation",
        "machine-stderr",
        "exit-envelope",
        "exit-expected",
        "cause-expected"
      ],
      "role": "command",
      "mode": "machine",
      "target": {
        "kind": "run",
        "program": "bun-runtime",
        "args": ["../../../specimens/target.mjs", "list", "--bogus", "--json"],
        "cwd": ".",
        "env": {
          "SPECIMEN_TABLE": "list-usage.table.json"
        }
      },
      "expect": {
        "exitCode": 2,
        "causeCode": "USAGE_INVALID_INVOCATION",
        "outcome": "refused",
        "commandIdentity": "specimen.list"
      }
    },
    {
      "caseId": "station-required.valid/list-preparation",
      "rules": [
        "json-framing",
        "version-malformed",
        "strict-keys",
        "result-correlation",
        "machine-stderr",
        "exit-envelope",
        "exit-expected",
        "cause-expected"
      ],
      "role": "command",
      "mode": "machine",
      "target": {
        "kind": "run",
        "program": "bun-runtime",
        "args": ["../../../specimens/target.mjs", "list", "--json"],
        "cwd": ".",
        "env": {
          "SPECIMEN_TABLE": "list-preparation.table.json",
          "SPECIMEN_FAULT": "preparation"
        }
      },
      "expect": {
        "exitCode": 1,
        "causeCode": "INTERNAL_PREPARATION",
        "outcome": "refused",
        "commandIdentity": "specimen.list"
      }
    },
    {
      "caseId": "station-required.valid/list-internal",
      "rules": [
        "json-framing",
        "version-malformed",
        "strict-keys",
        "result-correlation",
        "machine-stderr",
        "exit-envelope",
        "exit-expected",
        "cause-expected"
      ],
      "role": "command",
      "mode": "machine",
      "target": {
        "kind": "run",
        "program": "bun-runtime",
        "args": ["../../../specimens/target.mjs", "list", "--json"],
        "cwd": ".",
        "env": {
          "SPECIMEN_TABLE": "list-internal.table.json",
          "SPECIMEN_FAULT": "result"
        }
      },
      "expect": {
        "exitCode": 1,
        "causeCode": "INTERNAL_RESULT_UNCHANGED",
        "outcome": "failed",
        "commandIdentity": "specimen.list"
      }
    },
    {
      "caseId": "station-required.valid/subject",
      "rules": [
        "station-required",
        "json-framing",
        "version-malformed",
        "strict-keys",
        "result-correlation",
        "machine-stderr",
        "exit-envelope",
        "exit-expected",
        "cause-expected"
      ],
      "role": "command-discovery",
      "mode": "machine",
      "target": {
        "kind": "run",
        "program": "bun-runtime",
        "args": [
          "../../../specimens/target.mjs",
          "--discover-command",
          "specimen.list",
          "--json"
        ],
        "cwd": ".",
        "env": {
          "SPECIMEN_TABLE": "subject.table.json"
        }
      },
      "expect": {
        "exitCode": 0,
        "causeCode": "SUCCESS_UNCHANGED",
        "outcome": "success",
        "commandIdentity": "specimen.command-discovery"
      }
    }
  ]
}
