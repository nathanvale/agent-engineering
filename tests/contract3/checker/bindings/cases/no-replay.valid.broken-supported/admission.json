{
  "admissionVersion": 1,
  "cli": "specimen",
  "cases": [
    {
      "caseId": "no-replay.valid.broken-supported/subject",
      "rules": [
        "json-framing",
        "version-malformed",
        "version-major",
        "version-newer",
        "machine-stderr"
      ],
      "role": "command",
      "mode": "machine",
      "target": {
        "kind": "run",
        "program": "bun-runtime",
        "args": ["../../../specimens/target.mjs", "list", "--json"],
        "cwd": ".",
        "env": {
          "SPECIMEN_TABLE": "subject.table.json",
          "SPECIMEN_COUNTER": "no-replay.counter"
        }
      }
    }
  ]
}
