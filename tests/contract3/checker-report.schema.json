{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contract 3 checker report data, independent expectation revision 1",
  "description": "Engineering-owned VER-14 result.data shape, not an envelope extension or observed qualification.",
  "type": "object",
  "additionalProperties": false,
  "required": ["reportVersion", "rows"],
  "properties": {
    "reportVersion": {
      "const": 1
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ruleId",
          "caseId",
          "status",
          "findings",
          "evidence",
          "reason"
        ],
        "properties": {
          "ruleId": {
            "type": "string",
            "minLength": 1
          },
          "caseId": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "not_run",
              "skipped",
              "timed_out",
              "missing",
              "declared_unreachable"
            ]
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "message"],
              "properties": {
                "code": {
                  "type": "string",
                  "minLength": 1
                },
                "message": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "reason": {
            "type": ["string", "null"]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "passed"
                }
              }
            },
            "then": {
              "properties": {
                "findings": {
                  "maxItems": 0
                },
                "evidence": {
                  "minItems": 1
                },
                "reason": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "failed"
                }
              }
            },
            "then": {
              "properties": {
                "findings": {
                  "minItems": 1
                },
                "evidence": {
                  "minItems": 1
                },
                "reason": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "not_run",
                    "skipped",
                    "timed_out",
                    "missing",
                    "declared_unreachable"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "findings": {
                  "maxItems": 0
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "declared_unreachable"
                }
              }
            },
            "then": {
              "properties": {
                "evidence": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    }
  }
}
